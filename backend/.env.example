# Copy to .env for local development. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=console

# Must use the postgresql+asyncpg:// scheme.
DATABASE_URL=postgresql+asyncpg://tradeo:change-me@localhost:5432/tradeo
REDIS_URL=redis://:change-me@localhost:6379/0

# --- Authentication -------------------------------------------------------
# Master secret for OTP digests, session digests and CSRF signing. At least
# 32 characters; placeholders are rejected. Generate: openssl rand -hex 32
AUTH_SECRET_KEY=
# Browser-facing origin of the web app (Origin header check). No trailing slash.
PUBLIC_ORIGIN=http://localhost:3000
# disabled (default): no codes are sent, OTP requests return 503.
# console: development only. Prints the code to the terminal running the API,
#   and only if that terminal is interactive; never to logs. Refused in any
#   other APP_ENV. Real SMS is a later phase.
OTP_PROVIDER=disabled
# Number of reverse proxies in front of the API (the Next.js proxy counts as 1).
# 0 trusts only the socket peer, which is wrong behind a proxy: every user
# would share one rate-limit bucket.
TRUSTED_PROXY_HOPS=0

# --- Market data (read-only) ------------------------------------------------
# demo (default): deterministic demo data, labeled source=demo in responses.
# disabled: market endpoints return 503 MARKET_DATA_UNAVAILABLE.
MARKET_DATA_PROVIDER=demo

# Brokers (Phase B2): demo = simulated per-user connections, no provider calls;
# disabled: broker endpoints return 503 BROKER_UNAVAILABLE.
BROKER_PROVIDER=demo

# Strategies (Phase C1): false makes strategy endpoints return 503.
STRATEGIES_ENABLED=true

# Comma-separated.
ALLOWED_HOSTS=localhost,127.0.0.1
# Next.js dev server. Leave empty to disable CORS entirely.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Used by docker-compose.yml only (it also needs AUTH_SECRET_KEY above).
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
