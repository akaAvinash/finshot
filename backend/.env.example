# Copy to .env for local development. Never commit .env.
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=console

# Must use the postgresql+asyncpg:// scheme.
DATABASE_URL=postgresql+asyncpg://tradeo:change-me@localhost:5432/tradeo
REDIS_URL=redis://:change-me@localhost:6379/0

# Comma-separated.
ALLOWED_HOSTS=localhost,127.0.0.1
# Next.js dev server. Leave empty to disable CORS entirely.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Used by docker-compose.yml only.
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
